    "interpretations": [
      {
        "text": "Muloqotchanlik juda past. Odamlardan qocha d, yolg'izlikni sevadi. Jamoaviy ishlarda qiynaladi.",
        "min": 30,
        "max": 32
      },
      {
        "text": "Kamgap, tortinchoq. Yangi tanishuvlarni yoqtirmaydi. Faqat zarurat tug'ilganda muloqot qiladi.",
        "max": 29,
        "min": 25
      },
      {
        "text": "Muloqotchanligi o'rtacha. Notanish muhitda biroz noqulaylik sezadi, lekin vaziyatga moslasha oladi.",
        "min": 19,
        "max": 24
      },
      {
        "min": 14,
        "max": 18,
        "text": "Me'yoriy muloqotchanlik. Boshqalarni eshita oladi, o'z fikrini bayon qiladi, nizolarga sababsiz kirishmaydi."
      },
      {
        "text": "Juda muloqotchan. Har qanday mavzuda gaplasha oladi, yangi tanishuvlarni yaxshi ko'radi.",
        "min": 9,
        "max": 13
      },
      {
        "text": "'Hamma joyda bor'. Muloqotga o'ta moyilligi tufayli ba'zida boshqalarning joniga tegishi mumkin.",
        "min": 4,
        "max": 8
      },
      {
        "text": "Muloqotchanlik kasallik darajasida yuqori. Haddan tashqari ko'p gapiradi, boshqalarning shaxsiy chegaralarini buzadi.",
        "min": 0,
        "max": 3
      }
